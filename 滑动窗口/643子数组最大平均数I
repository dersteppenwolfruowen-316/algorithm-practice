class Solution:
    def findMaxAverage(self, nums: List[int], k: int) -> float:
        res = -inf
        vol = 0 
        for right, num in enumerate(nums):
            vol += num
            left = right - k + 1
            if left < 0:
                continue
            res = max(res, vol)
            vol -= nums[left]
        return res/k